/* ==========================================================
   CONFIG PAGE - KPI DROPDOWN OVERLAY FIX
========================================================== */

/*
   KPI section must be above the Filter section.
   This MUST be higher than the global .dash-dropdown z-index: 9999.
*/
.config-kpi-selection {
    position: relative !important;
    z-index: 100000 !important;
    overflow: visible !important;
}

/* KPI dropdown */
.config-kpi-selection .config-kpi-dropdown {
    position: relative !important;
    z-index: 100001 !important;
}

/* KPI dropdown menu */
.config-kpi-selection .dash-dropdown-menu {
    position: absolute !important;
    z-index: 999999 !important;
}

/* Older Dash / React-select menu */
.config-kpi-selection .Select-menu-outer {
    z-index: 999999 !important;
    background: #ffffff !important;
}

.config-kpi-selection .Select-menu {
    z-index: 999999 !important;
    background: #ffffff !important;
}

/* Keep menu options readable */
.config-kpi-selection .VirtualizedSelectOption {
    background: #ffffff !important;
    padding: 10px 14px !important;
}

.config-kpi-selection .VirtualizedSelectFocusedOption {
    background: #EEF4FF !important;
}


/*
   Filter section stays BELOW the KPI section.
*/
.config-filter-selection {
    position: relative !important;
    z-index: 1 !important;
    overflow: visible !important;
}

/*
   Do NOT allow the filter dropdown's global z-index
   to beat the KPI section.
*/
.config-filter-selection .dash-dropdown {
    z-index: 2 !important;
}
