/* ==========================================================
   CONFIG PAGE - KPI DROPDOWN FIX
========================================================== */

/* The KPI card must appear above the Filter card */
.config-kpi-selection {
    position: relative !important;
    z-index: 1000 !important;
    overflow: visible !important;
}

/* KPI dropdown itself */
.config-kpi-selection .config-kpi-dropdown {
    position: relative !important;
    z-index: 1001 !important;
}

/* Dash dropdown container */
.config-kpi-selection .dash-dropdown {
    position: relative !important;
    z-index: 1002 !important;
}

/* Dropdown menu */
.config-kpi-selection .dash-dropdown-menu {
    z-index: 999999 !important;
}

/* Older Dash / React-select structure */
.config-kpi-selection .Select-menu-outer {
    z-index: 999999 !important;
    background: #ffffff !important;
}

.config-kpi-selection .Select-menu {
    z-index: 999999 !important;
    background: #ffffff !important;
}

/* Dropdown options */
.config-kpi-selection .VirtualizedSelectOption {
    background: #ffffff !important;
    padding: 10px 14px !important;
}

.config-kpi-selection .VirtualizedSelectFocusedOption {
    background: #EEF4FF !important;
}
